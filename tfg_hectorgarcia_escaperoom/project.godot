; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="TFG_HectorGarcia_EscapeRoom"
run/main_scene="uid://bovt4e6usq8s"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameManager="*res://Scenes/game_manager.tscn"
goat_audio_bus="*res://addons/goat/autoload/audio_bus.gd"
goat_locale="*res://addons/goat/autoload/locale.gd"
goat_utils="*res://addons/goat/globals/goat_utils.gd"
goat="*res://addons/goat/globals/goat.gd"
goat_state="*res://addons/goat/globals/goat_state.gd"
goat_inventory="*res://addons/goat/globals/goat_inventory.gd"
goat_interaction="*res://addons/goat/globals/goat_interaction.gd"
goat_voice="*res://addons/goat/globals/goat_voice.gd"
goat_settings="*res://addons/goat/globals/goat_settings.gd"
DialogueManager="*res://addons/goat/addons/dialogue_manager/dialogue_manager.gd"
SocketIoClient="*res://Scripts/SocketIOClient.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/goat/plugin.cfg", "res://addons/project-time-tracker/plugin.cfg")

[file_customization]

folder_colors={
"res://Images/": "gray",
"res://Models/": "yellow",
"res://Scenes/": "red",
"res://Scripts/": "blue",
"res://UI/": "green",
"res://addons/goat/main_scenes/": "purple",
"res://resources/": "teal"
}

[global_group]

signals_test=""
abrir_modulo=""
abrir_caja=""
terminar_escaperoom=""

[goat]

general/game_resources_directory="res://resources"

[gui]

theme/custom_font="uid://d4ckm2dc8y6uc"

